[gd_resource type="ShaderMaterial" load_steps=2 format=3]

[sub_resource type="Shader" id="Shader_shin_getter_transition"]
code = "shader_type canvas_item;

uniform float threshold : hint_range(0.0, 1.0);

bool edge_crosses(vec2 p, vec2 a, vec2 b) {
    if ((a.y > p.y) == (b.y > p.y)) {
        return false;
    }

    float crossing_x = (b.x - a.x) * (p.y - a.y) / (b.y - a.y) + a.x;
    return p.x < crossing_x;
}

bool point_in_polygon7(vec2 p, vec2 a, vec2 b, vec2 c, vec2 d, vec2 e, vec2 f, vec2 g) {
    bool inside = false;
    if (edge_crosses(p, a, b)) inside = !inside;
    if (edge_crosses(p, b, c)) inside = !inside;
    if (edge_crosses(p, c, d)) inside = !inside;
    if (edge_crosses(p, d, e)) inside = !inside;
    if (edge_crosses(p, e, f)) inside = !inside;
    if (edge_crosses(p, f, g)) inside = !inside;
    if (edge_crosses(p, g, a)) inside = !inside;
    return inside;
}

bool point_in_polygon6(vec2 p, vec2 a, vec2 b, vec2 c, vec2 d, vec2 e, vec2 f) {
    bool inside = false;
    if (edge_crosses(p, a, b)) inside = !inside;
    if (edge_crosses(p, b, c)) inside = !inside;
    if (edge_crosses(p, c, d)) inside = !inside;
    if (edge_crosses(p, d, e)) inside = !inside;
    if (edge_crosses(p, e, f)) inside = !inside;
    if (edge_crosses(p, f, a)) inside = !inside;
    return inside;
}

bool point_in_polygon4(vec2 p, vec2 a, vec2 b, vec2 c, vec2 d) {
    bool inside = false;
    if (edge_crosses(p, a, b)) inside = !inside;
    if (edge_crosses(p, b, c)) inside = !inside;
    if (edge_crosses(p, c, d)) inside = !inside;
    if (edge_crosses(p, d, a)) inside = !inside;
    return inside;
}

bool top_shape(vec2 p, float progress) {
    p -= mix(vec2(0.0, -0.9890), vec2(0.0), progress);
    return point_in_polygon7(
        p,
        vec2(0.0000, 0.0000),
        vec2(0.9989, 0.0000),
        vec2(0.6480, 0.3386),
        vec2(0.4624, 0.7843),
        vec2(0.1041, 0.1199),
        vec2(0.0013, 0.9890),
        vec2(0.0000, 0.9890));
}

bool lower_left_shape(vec2 p, float progress) {
    p -= mix(vec2(-0.3200, 0.4979), vec2(0.0), progress);
    return point_in_polygon4(
        p,
        vec2(0.1041, 0.1199),
        vec2(0.4631, 0.7856),
        vec2(1.0000, 1.0000),
        vec2(0.0000, 1.0000));
}

bool right_shape(vec2 p, float progress) {
    p -= mix(vec2(0.5390, -0.0244), vec2(0.0), progress);
    return point_in_polygon6(
        p,
        vec2(0.6480, 0.3386),
        vec2(0.9989, 0.0000),
        vec2(1.0000, 0.0000),
        vec2(1.0000, 0.5000),
        vec2(1.0000, 1.0000),
        vec2(0.4610, 0.7879));
}

void fragment() {
    float progress = smoothstep(0.0, 1.0, clamp(threshold, 0.0, 1.0));
    bool covered = top_shape(UV, progress)
        || lower_left_shape(UV, progress)
        || right_shape(UV, progress);
    float shape_alpha = covered ? smoothstep(0.01, 0.08, progress) : 0.0;
    COLOR = vec4(0.0, 0.0, 0.0, max(shape_alpha, step(0.995, progress)));
}
"

[resource]
resource_local_to_scene = true
shader = SubResource("Shader_shin_getter_transition")
shader_parameter/threshold = 0.0
