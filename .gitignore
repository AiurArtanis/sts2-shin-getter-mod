# Godot generated files
/shin-getter-mod-godot/.godot/
/shin-getter-mod-godot/Godot/
/shin-getter-mod-godot/android/

# IDE and .NET build output
.vs/
bin/
obj/
*.user
*.suo
*.pdb
*.tmp
*.Backup.tmp
tmp/
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Mod build/export output
/shin-getter-mod-godot/build/
*.pck

# Local game assemblies. Restore these from the installed game.
/shin-getter-mod-godot/lib/*.dll

# Game/editor addons are local SDK dependencies, not mod source.
/shin-getter-mod-godot/addons/

# Local export credentials and logs
export_credentials.cfg
*.log

# Local development checks and planning notes
*.ps1
/docs/

# Headless-test harness runtime and local package artifacts stay outside Git.
/headless-test-harness/.runtime/
/headless-test-harness/**/.state/
/headless-test-harness/**/dist/
/headless-test-harness/**/*.egg-info/
/headless-test-harness/bridge/**/package-out/
