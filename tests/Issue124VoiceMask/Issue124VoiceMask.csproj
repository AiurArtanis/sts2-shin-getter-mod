<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ModOutput Condition="'$(ModOutput)' == ''">../../shin-getter-mod-godot/.godot/mono/temp/bin/Debug</ModOutput>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="ShinGetterMod"><HintPath>$(ModOutput)/ShinGetterMod.dll</HintPath></Reference>
    <Reference Include="sts2"><HintPath>$(ModOutput)/sts2.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>$(ModOutput)/0Harmony.dll</HintPath></Reference>
    <Reference Include="GodotSharp"><HintPath>$(ModOutput)/GodotSharp.dll</HintPath></Reference>
  </ItemGroup>
</Project>
