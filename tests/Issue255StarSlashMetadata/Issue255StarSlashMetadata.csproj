<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="GodotSharp">
      <HintPath>../../shin-getter-mod-godot/.godot/mono/temp/bin/Debug/GodotSharp.dll</HintPath>
    </Reference>
    <Compile Include="../../shin-getter-mod-godot/src/Nodes/Combat/NShinGetterStarSlashData.cs" Link="ProductionData.cs" />
    <Compile Include="obj/LegacyData.cs" Link="LegacyData.cs" />
    <Compile Include="../../shin-getter-mod-godot/src/Nodes/Combat/NShinGetterStarSlashSequence.cs" Link="ProductionSequence.cs" />
    <Compile Include="obj/LegacySequence.cs" Link="LegacySequence.cs" />
  </ItemGroup>
  <!-- Native API stubs intentionally shadow these imported classes; Vector2/Rect2/Color
       math still uses the installed GodotSharp structs. No native engine is started. -->
  <PropertyGroup><NoWarn>$(NoWarn);CS0436</NoWarn></PropertyGroup>
</Project>
