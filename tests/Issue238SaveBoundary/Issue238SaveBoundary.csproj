<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <SteamworksAssemblyPath Condition="'$(SteamworksAssemblyPath)' == ''">$(Sts2ReferenceDir)/Steamworks.NET.dll</SteamworksAssemblyPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="ShinGetterMod"><HintPath>$(ModAssemblyPath)</HintPath></Reference>
    <Reference Include="sts2"><HintPath>$(Sts2ReferenceDir)/sts2.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>$(Sts2ReferenceDir)/0Harmony.dll</HintPath></Reference>
    <Reference Include="GodotSharp"><HintPath>$(Sts2ReferenceDir)/GodotSharp.dll</HintPath></Reference>
    <Reference Include="Sentry"><HintPath>$(Sts2ReferenceDir)/Sentry.dll</HintPath></Reference>
    <Reference Include="Sentry.Godot"><HintPath>$(Sts2ReferenceDir)/Sentry.Godot.dll</HintPath></Reference>
    <Reference Include="System.IO.Hashing"><HintPath>$(Sts2ReferenceDir)/System.IO.Hashing.dll</HintPath></Reference>
    <Reference Include="Steamworks.NET"><HintPath>$(SteamworksAssemblyPath)</HintPath></Reference>
  </ItemGroup>
</Project>
