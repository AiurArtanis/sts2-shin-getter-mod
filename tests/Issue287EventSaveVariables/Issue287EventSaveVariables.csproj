  </PropertyGroup>
  <ItemGroup>
    <Reference Include="ShinGetterMod"><HintPath>$(ModAssemblyPath)</HintPath></Reference>
    <Reference Include="sts2"><HintPath>../../shin-getter-mod-godot/lib/sts2.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>../../shin-getter-mod-godot/lib/0Harmony.dll</HintPath></Reference>
