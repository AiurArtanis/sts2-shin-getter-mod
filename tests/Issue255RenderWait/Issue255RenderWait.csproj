<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ProductionServicePath Condition="'$(ProductionServicePath)' == ''">../../shin-getter-mod-godot/src/Services/ShinGetterCombatRenderPreparation.cs</ProductionServicePath>
    <ProductionPatchPath Condition="'$(ProductionPatchPath)' == ''">../../shin-getter-mod-godot/src/Patches/ShinGetterCombatRenderPreparationPatch.cs</ProductionPatchPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ProductionServicePath)" Link="ProductionService.cs" />
    <Compile Include="$(ProductionPatchPath)" Link="ProductionPatch.cs" />
  </ItemGroup>
</Project>
