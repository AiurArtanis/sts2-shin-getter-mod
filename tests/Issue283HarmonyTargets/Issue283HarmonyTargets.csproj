<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Sts2ReferenceDir Condition="'$(Sts2ReferenceDir)' == ''">$(MSBuildProjectDirectory)/../../shin-getter-mod-godot/lib</Sts2ReferenceDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="GodotSharp" Version="4.5.1" />
    <Reference Include="sts2"><HintPath>$(Sts2ReferenceDir)/sts2.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>$(Sts2ReferenceDir)/0Harmony.dll</HintPath></Reference>
    <Compile Include="../../shin-getter-mod-godot/src/Patches/ShinGetterTrialCombatSyncPatch.cs" Link="Production/Patches.cs" />
  </ItemGroup>
  <Target Name="CheckPinnedInputs" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(Sts2ReferenceDir)/sts2.dll') Or !Exists('$(Sts2ReferenceDir)/0Harmony.dll')" Text="Supply -p:Sts2ReferenceDir with the read-only formal109 sts2.dll and actual 0Harmony.dll." />
  </Target>
</Project>
