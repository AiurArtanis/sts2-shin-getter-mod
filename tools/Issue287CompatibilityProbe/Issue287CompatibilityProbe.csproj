<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UseSharedCompilation>false</UseSharedCompilation>
    <CecilPath Condition="'$(CecilPath)' == ''">$(UserProfile)\.nuget\packages\microsoft.codecoverage\17.11.1\build\netstandard2.0\Mono.Cecil.dll</CecilPath>
    <ProbeRoslynDirectory Condition="'$(ProbeRoslynDirectory)' == ''">C:\Program Files\dotnet\sdk\9.0.321\Roslyn\bincore</ProbeRoslynDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Mono.Cecil"><HintPath>$(CecilPath)</HintPath></Reference>
    <Reference Include="Microsoft.CodeAnalysis"><HintPath>$(ProbeRoslynDirectory)\Microsoft.CodeAnalysis.dll</HintPath></Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp"><HintPath>$(ProbeRoslynDirectory)\Microsoft.CodeAnalysis.CSharp.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>..\..\shin-getter-mod-godot\lib\0Harmony.dll</HintPath></Reference>
  </ItemGroup>
</Project>
