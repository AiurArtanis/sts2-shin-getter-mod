{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shingetter.invalid/schemas/scenario-v1.schema.json",
  "title": "STS2 declarative scenario v1",
  "type": "object",
  "required": ["schema", "case_id", "requires", "instances", "seed", "steps"],
  "properties": {
    "schema": {"const": "sts2-scenario/v1"},
    "case_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "requires": {
      "type": "object",
      "required": ["game_version", "capabilities"],
      "properties": {
        "game_version": {"type": "string"},
        "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "instances": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "role", "client_id", "mode"],
        "properties": {
          "id": {"type": "string"},
          "role": {"enum": ["single", "host", "client"]},
          "client_id": {"type": "integer", "minimum": 1},
          "mode": {"enum": ["H0", "H1", "H2"]}
        },
        "additionalProperties": false
      }
    },
    "seed": {"type": "integer"},
    "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}}
  },
  "additionalProperties": false,
  "$defs": {
    "step": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "command": {"type": "string"},
        "dispatch": {"type": "object", "required": ["command"], "properties": {"command": {"type": "string"}, "args": {"type": "object"}, "wait_for": {"type": "string"}}, "additionalProperties": false},
        "args": {"type": "object"},
        "wait_event": {"type": "object", "required": ["request_id", "name"], "properties": {"request_id": {}, "name": {"type": "string"}}, "additionalProperties": false},
        "wait_terminal": {"type": "object", "required": ["request_id"], "properties": {"request_id": {}}, "additionalProperties": false},
        "assert": {"type": "object"},
        "capture": {},
        "expect": {"type": "object"},
        "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 60000},
        "snapshot": {"type": "boolean"},
        "snapshot_disabled_reason": {"type": "string"}
      },
      "oneOf": [
        {"required": ["command"]},
        {"required": ["dispatch"]},
        {"required": ["wait_event"]},
        {"required": ["wait_terminal"]},
        {"required": ["assert"]}
      ],
      "additionalProperties": false
    }
  }
}
